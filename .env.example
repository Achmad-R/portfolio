# Database (Supabase)
# Pooler (port 6543) untuk runtime — Vercel serverless
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (port 5432) khusus prisma migrate
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Auth.js
AUTH_SECRET="<generate: openssl rand -base64 32>"
AUTH_TRUST_HOST=true

# Admin
ADMIN_EMAIL="achmad.ridho.st@gmail.com"
ADMIN_PASSWORD="<password admin awal>"

# Resend
RESEND_API_KEY="<resend-api-key>"
CONTACT_NOTIFY_EMAIL="achmad.ridho.st@gmail.com"

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
